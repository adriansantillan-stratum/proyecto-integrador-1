<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P08" targetNamespace="https://ecoroute.pe/procesos-negocio">
  <bpmn:process id="Process_P08" name="Administrar accesos" isExecutable="false">
    <bpmn:documentation>Modelo de negocio MICOTRANS. La Jefatura justifica la necesidad del acceso y el Administrador asigna los permisos autorizados. Keycloak es la autoridad de identidad y roles. El backend valida firma, emisor, vigencia y revocación del JWT. Para un conductor compara el sub validado con drivers.external_id; no confía en un driverId elegido libremente por la aplicación. El panel modifica roles efectivos y habilitación en Keycloak mediante un cliente de servicio local autorizado. Las cuentas técnicas no son administrables como personas desde ese panel y se impide que un administrador se retire su propio acceso. Los cambios revocan tokens anteriores y sesiones y dejan auditoría. Las tablas auth_* heredadas no gobiernan estos permisos. Keycloak mantiene una base distinta de la base logística.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P08">
      <bpmn:lane id="Lane_P08_0" name="Jefatura logística">
        <bpmn:flowNodeRef>P08_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P08_1" name="Administrador">
        <bpmn:flowNodeRef>P08_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_M_A5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_S" name="Solicitud de acceso">
      <bpmn:outgoing>Flow_P08_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P08_A1" name="Precisar cargo y necesidad">
      <bpmn:incoming>Flow_P08_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_G1" name="¿Solicitud autorizada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P08_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P08_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_A2" name="Informar rechazo">
      <bpmn:incoming>Flow_P08_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P08_E1" name="Acceso denegado">
      <bpmn:incoming>Flow_P08_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P08_A3" name="Definir rol mínimo necesario">
      <bpmn:incoming>Flow_P08_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_G2" name="¿Es baja o revocación?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P08_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_P08_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_A4" name="Revocar acceso y sesiones">
      <bpmn:incoming>Flow_P08_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P08_E2" name="Acceso revocado">
      <bpmn:incoming>Flow_P08_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P08_A5" name="Crear o ajustar acceso y rol">
      <bpmn:incoming>Flow_P08_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P08_A6" name="Comprobar acceso permitido">
      <bpmn:incoming>Flow_P08_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_G3" name="¿Permisos correctos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P08_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P08_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P08_A7" name="Corregir rol y registrar cambio">
      <bpmn:incoming>Flow_P08_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P08_A8" name="Confirmar activación al solicitante">
      <bpmn:incoming>Flow_P08_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P08_E3" name="Acceso habilitado">
      <bpmn:incoming>Flow_P08_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P08_M_A5" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_P08_8</bpmn:incoming>
      <bpmn:incoming>Flow_P08_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P08_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_P08_1" sourceRef="P08_S" targetRef="P08_A1"/>
    <bpmn:sequenceFlow id="Flow_P08_2" sourceRef="P08_A1" targetRef="P08_G1"/>
    <bpmn:sequenceFlow id="Flow_P08_3" sourceRef="P08_G1" targetRef="P08_A3" name="Sí">
