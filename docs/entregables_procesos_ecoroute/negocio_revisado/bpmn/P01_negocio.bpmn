        <bpmn:flowNodeRef>P01_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_M_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_M_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_M_A6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P01_S" name="Solicitud recibida">
      <bpmn:outgoing>Flow_P01_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P01_A1" name="Recibir solicitud y condiciones">
      <bpmn:incoming>Flow_P01_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P01_A2" name="Revisar datos mínimos">
      <bpmn:incoming>Flow_P01_26</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G1" name="¿Datos completos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P01_A3" name="Solicitar corrección">
      <bpmn:incoming>Flow_P01_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G2" name="¿Cliente corrige a tiempo?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P01_E1" name="Solicitud no admitida">
      <bpmn:incoming>Flow_P01_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P01_A4" name="Revisar dirección y duplicidad">
      <bpmn:incoming>Flow_P01_27</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G3" name="¿Dirección utilizable?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P01_A5" name="Aclarar ubicación con cliente">
      <bpmn:incoming>Flow_P01_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G4" name="¿Ubicación aclarada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P01_E2" name="Solicitud no viable">
      <bpmn:incoming>Flow_P01_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P01_A6" name="Validar cobertura y ventana">
      <bpmn:incoming>Flow_P01_28</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G5" name="¿Servicio factible?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P01_A7" name="Proponer fecha o condición alternativa">
      <bpmn:incoming>Flow_P01_17</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P01_G6" name="¿Cliente acepta alternativa?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_18</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P01_E3" name="Solicitud desistida">
      <bpmn:incoming>Flow_P01_20</bpmn:incoming>
      <bpmn:incoming>Flow_P01_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P01_A8" name="Comunicar condiciones al cliente" messageRef="Message_P01_Propuesta">
      <bpmn:incoming>Flow_P01_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="P01_A8b" name="Recibir respuesta del cliente" messageRef="Message_P01_Respuesta">
      <bpmn:incoming>Flow_P01_21</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="P01_G7" name="¿Cliente confirma?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P01_22</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_P01_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P01_A9" name="Registrar pedido sin ruta (PENDING)">
      <bpmn:incoming>Flow_P01_23</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P01_E4" name="Pedido validado → P02">
      <bpmn:incoming>Flow_P01_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P01_M_A2" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_P01_2</bpmn:incoming>
      <bpmn:incoming>Flow_P01_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P01_26</bpmn:outgoing>
