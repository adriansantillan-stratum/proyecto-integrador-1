      <bpmn:outgoing>Flow_P04_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_E1" name="Reintento autorizado → P03">
      <bpmn:incoming>Flow_P04_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_A7" name="Acordar nueva fecha">
      <bpmn:incoming>Flow_P04_22</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_G5" name="¿Reprogramación aceptada?" gatewayDirection="Diverging">
