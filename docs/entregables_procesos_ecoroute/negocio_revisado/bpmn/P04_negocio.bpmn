<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P04" targetNamespace="https://ecoroute.pe/procesos-negocio">
  <bpmn:process id="Process_P04" name="Resolver incidencias" isExecutable="false">
    <bpmn:documentation>Modelo de negocio MICOTRANS. Un resultado FAILED o RETURNED exige motivo y abre una incidencia del pedido. El Dispatcher revisa su sustento y coordina la solución con las personas afectadas. RETRY requiere que la jornada siga activa y crea otro intento IN_TRANSIT. REPLAN requiere una ruta PLANNED y crea otro intento ASSIGNED vinculado al original mediante order_attempts. El resultado del pedido original permanece intacto. La reprogramación exige nueva aceptación del cliente y permite acordar una nueva ventana antes de aprobar la jornada. Si el reintento en la jornada ya no es viable, debe reprogramarse; no se reabre una ruta cerrada. La Jefatura autoriza CLOSE_FAILED para un resultado fallido o devuelto. CLOSE_CASE cierra una incidencia general o una disputa sin convertir una entrega acreditada en fallida. La resolución se audita e impide duplicar intentos al reenviarse.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P04">
      <bpmn:lane id="Lane_P04_0" name="Conductor">
        <bpmn:flowNodeRef>P04_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_M_A1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P04_1" name="Dispatcher">
        <bpmn:flowNodeRef>P04_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_M_A5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P04_2" name="Jefatura logística">
        <bpmn:flowNodeRef>P04_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_M_A7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_S" name="Excepción registrada">
      <bpmn:outgoing>Flow_P04_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P04_A1" name="Describir causa y adjuntar sustento">
      <bpmn:incoming>Flow_P04_20</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P04_A2" name="Revisar evidencia y urgencia">
      <bpmn:incoming>Flow_P04_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_G1" name="¿Sustento suficiente?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P04_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P04_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P04_A3" name="Solicitar complemento">
      <bpmn:incoming>Flow_P04_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_G2" name="¿Puede completarse?" gatewayDirection="Diverging">
