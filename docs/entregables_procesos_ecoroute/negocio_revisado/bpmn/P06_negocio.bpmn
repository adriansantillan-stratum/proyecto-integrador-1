<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P06" targetNamespace="https://ecoroute.pe/procesos-negocio">
  <bpmn:process id="Process_P06" name="Habilitar recursos de reparto" isExecutable="false">
    <bpmn:documentation>Modelo de negocio MICOTRANS. La empresa determina si el personal y el vehículo están aptos antes de asignarlos. Las pantallas de Conductores y Vehículos registran datos, capacidades y condición activa. El servidor rechaza la planificación con recursos inactivos y los conflictos de reserva por fecha. El vínculo con una cuenta DRIVER es una operación de identidad separada del alta de datos del conductor. Las revisiones documentales, licencias vigentes, mantenimiento físico y disponibilidad real requieren documentos y decisiones humanas. isActive no equivale a un control automático de vencimientos. Si el recurso no cumple, no se habilita para la jornada y la gestión debe corregirlo o seleccionar un sustituto. No se presenta un CRUD como certificación de aptitud.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P06">
      <bpmn:lane id="Lane_P06_0" name="Jefatura logística">
        <bpmn:flowNodeRef>P06_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P06_1" name="Administrador">
        <bpmn:flowNodeRef>P06_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_M_A2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P06_2" name="Dispatcher">
        <bpmn:flowNodeRef>P06_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P06_S" name="Necesidad de recurso">
      <bpmn:outgoing>Flow_P06_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P06_A1" name="Definir perfil o capacidad requerida">
      <bpmn:incoming>Flow_P06_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P06_A2" name="Recibir documentos y datos">
      <bpmn:incoming>Flow_P06_19</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P06_G1" name="¿Información completa?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P06_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P06_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P06_A3" name="Solicitar subsanación">
      <bpmn:incoming>Flow_P06_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P06_G2" name="¿Se subsana en plazo?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P06_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_P06_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P06_E1" name="Solicitud archivada">
      <bpmn:incoming>Flow_P06_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P06_A4" name="Verificar licencia o estado del vehículo">
      <bpmn:incoming>Flow_P06_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P06_G3" name="¿Recurso apto?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P06_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_P06_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P06_A5" name="Bloquear recurso e informar motivo">
      <bpmn:incoming>Flow_P06_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P06_E2" name="Recurso no habilitado">
      <bpmn:incoming>Flow_P06_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P06_A6" name="Registrar conductor o vehículo">
      <bpmn:incoming>Flow_P06_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P06_A7" name="Validar capacidad y disponibilidad">
      <bpmn:incoming>Flow_P06_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P06_G4" name="¿Disponible para jornada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P06_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_P06_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P06_A8" name="Programar disponibilidad futura">
      <bpmn:incoming>Flow_P06_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P06_E3" name="Recurso en espera">
      <bpmn:incoming>Flow_P06_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P06_A9" name="Liberar recurso para asignación">
      <bpmn:incoming>Flow_P06_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P06_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P06_E4" name="Recurso habilitado → P02">
      <bpmn:incoming>Flow_P06_18</bpmn:incoming>
    </bpmn:endEvent>
