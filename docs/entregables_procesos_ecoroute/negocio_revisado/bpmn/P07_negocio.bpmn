<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P07" targetNamespace="https://ecoroute.pe/procesos-negocio">
  <bpmn:process id="Process_P07" name="Supervisar la jornada" isExecutable="false">
    <bpmn:documentation>Modelo de negocio MICOTRANS. El Conductor comparte muestras GPS con los identificadores reales de la ruta. Cada ping requiere identidad vinculada, vehículo propio y una jornada en ejecución. Se conserva el historial y se publica el punto por Redis. El mapa web abre un WebSocket y autentica su primer mensaje con JWT y vehicleId; una conexión anónima no recibe ubicaciones y se cierra con política de acceso. Si el canal en vivo falla, la interfaz dispone de consulta periódica y debe indicar la situación. El Dispatcher analiza pérdida de señal o desvíos y contacta al Conductor antes de escalar a P04. La falta de GPS no acredita automáticamente robo, retraso ni entrega. Los umbrales y protocolos de respuesta empresarial deben acordarse y validarse en el piloto.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P07">
      <bpmn:lane id="Lane_P07_0" name="Conductor">
        <bpmn:flowNodeRef>P07_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_M_A1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P07_1" name="Dispatcher">
        <bpmn:flowNodeRef>P07_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_M_A7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P07_2" name="Jefatura logística">
        <bpmn:flowNodeRef>P07_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_S" name="Ruta en ejecución">
      <bpmn:outgoing>Flow_P07_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P07_A1" name="Compartir avance de la ruta">
      <bpmn:incoming>Flow_P07_19</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_G1" name="¿Se reciben datos recientes?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P07_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P07_A2" name="Contactar al conductor">
      <bpmn:incoming>Flow_P07_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_G2" name="¿Se restablece seguimiento?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P07_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P07_A3" name="Registrar pérdida de señal">
      <bpmn:incoming>Flow_P07_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07_E1" name="Alerta técnica → P04">
      <bpmn:incoming>Flow_P07_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P07_A4" name="Comparar avance con ventana">
      <bpmn:incoming>Flow_P07_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_G3" name="¿Hay desvío o demora?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P07_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P07_A5" name="Confirmar causa con conductor">
      <bpmn:incoming>Flow_P07_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_G4" name="¿Se requiere intervención?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P07_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P07_A6" name="Escalar y registrar alerta">
      <bpmn:incoming>Flow_P07_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07_E2" name="Incidencia → P04">
      <bpmn:incoming>Flow_P07_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P07_A7" name="Actualizar seguimiento">
      <bpmn:incoming>Flow_P07_20</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_G5" name="¿Ruta finalizada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P07_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P07_E3" name="Resultado de jornada → P05">
      <bpmn:incoming>Flow_P07_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P07_M_A1" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_P07_1</bpmn:incoming>
      <bpmn:incoming>Flow_P07_6</bpmn:incoming>
