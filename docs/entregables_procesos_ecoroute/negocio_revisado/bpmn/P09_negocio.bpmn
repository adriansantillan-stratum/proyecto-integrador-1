<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P09" targetNamespace="https://ecoroute.pe/procesos-negocio">
  <bpmn:process id="Process_P09" name="Registrar compras operativas" isExecutable="false">
    <bpmn:documentation>Modelo de negocio MICOTRANS. El negocio identifica la necesidad, comprueba presupuesto, selecciona proveedor y autoriza el gasto antes de adquirir. La aplicación aporta el registro de compra, proveedor, importe, categoría, observaciones y estado, con consulta y modificación. Los comprobantes físicos, aprobación presupuestaria y recepción conforme deben acompañar la decisión empresarial. Si no hay aprobación, se ajusta la solicitud o se cancela con motivo. Si la recepción no es conforme, se gestiona devolución o corrección con el proveedor. El CRUD existente solo apoya una parte de P09; no constituye un ERP, un almacén automatizado ni una aprobación bancaria. Esta frontera se mantiene explícita en el mapeo y las pruebas de aceptación.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P09">
      <bpmn:lane id="Lane_P09_0" name="Dispatcher">
        <bpmn:flowNodeRef>P09_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P09_1" name="Administrador">
        <bpmn:flowNodeRef>P09_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_M_A4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P09_2" name="Jefatura logística">
        <bpmn:flowNodeRef>P09_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_G2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P09_S" name="Necesidad de compra">
      <bpmn:outgoing>Flow_P09_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P09_A1" name="Describir necesidad y prioridad">
      <bpmn:incoming>Flow_P09_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_A2" name="Comprobar existencia y presupuesto">
      <bpmn:incoming>Flow_P09_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P09_G1" name="¿Hay existencia utilizable?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P09_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P09_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P09_A3" name="Entregar recurso existente">
      <bpmn:incoming>Flow_P09_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P09_E1" name="Necesidad cubierta sin compra">
      <bpmn:incoming>Flow_P09_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P09_A4" name="Evaluar costo y proveedor">
      <bpmn:incoming>Flow_P09_19</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P09_A5" name="Autorizar gasto">
      <bpmn:incoming>Flow_P09_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P09_G2" name="¿Gasto aprobado?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P09_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_P09_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P09_A6" name="Ajustar o cancelar solicitud">
      <bpmn:incoming>Flow_P09_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P09_G3" name="¿Se justifica nuevo intento?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P09_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P09_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P09_E2" name="Solicitud cancelada">
      <bpmn:incoming>Flow_P09_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P09_A7" name="Realizar compra y recibir bien">
      <bpmn:incoming>Flow_P09_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P09_G4" name="¿Recepción conforme?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P09_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_P09_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P09_A8" name="Reclamar o devolver">
      <bpmn:incoming>Flow_P09_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P09_E3" name="Compra observada">
      <bpmn:incoming>Flow_P09_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P09_A9" name="Registrar compra y comprobante">
      <bpmn:incoming>Flow_P09_15</bpmn:incoming>
      <bpmn:outgoing>Flow_P09_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P09_E4" name="Compra registrada → P06">
      <bpmn:incoming>Flow_P09_18</bpmn:incoming>
    </bpmn:endEvent>
