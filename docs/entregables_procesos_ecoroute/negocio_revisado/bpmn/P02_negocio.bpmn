      <bpmn:outgoing>Flow_P02_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P02_E1" name="Pedidos en cartera; nueva fecha">
      <bpmn:incoming>Flow_P02_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P02_A4" name="Crear ruta PLANNED para la fecha">
