      <bpmn:outgoing>Flow_P02_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P02_A5" name="Vincular pedidos PENDING a ruta [objetivo]">
      <bpmn:incoming>Flow_P02_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P02_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P02_G3" name="¿Pedidos vinculados?" gatewayDirection="Diverging">
