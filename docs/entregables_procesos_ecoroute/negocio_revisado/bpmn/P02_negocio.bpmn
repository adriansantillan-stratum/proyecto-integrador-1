      <bpmn:outgoing>Flow_P02_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P02_E2" name="Asignación pendiente; no despachar">
      <bpmn:incoming>Flow_P02_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P02_A7" name="Revisar recorrido propuesto">
