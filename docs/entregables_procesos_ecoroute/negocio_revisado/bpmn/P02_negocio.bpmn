      <bpmn:outgoing>Flow_P02_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_P02_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P02_A6" name="Corregir datos o asignación">
