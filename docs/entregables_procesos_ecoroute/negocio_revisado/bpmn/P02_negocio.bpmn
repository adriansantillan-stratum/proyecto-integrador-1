        <bpmn:flowNodeRef>P02_M_A9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P02_1" name="Jefatura logística">
        <bpmn:flowNodeRef>P02_A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_G5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P02_2" name="Conductor">
        <bpmn:flowNodeRef>P02_A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_G6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_S" name="Pedidos validados PENDING">
      <bpmn:outgoing>Flow_P02_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P02_A1" name="Consolidar demanda del día">
      <bpmn:incoming>Flow_P02_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P02_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P02_A2" name="Seleccionar conductor y vehículo">
      <bpmn:incoming>Flow_P02_30</bpmn:incoming>
      <bpmn:outgoing>Flow_P02_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P02_G1" name="¿Recursos disponibles?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_P02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P02_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P02_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P02_A3" name="Ajustar carga o recursos">
